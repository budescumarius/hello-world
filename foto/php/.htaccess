# Foto Șantier
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(api|files)(/.*)?$ api.php [QSA,L]
</IfModule>

# Datele (baza de date și pozele) nu sunt accesibile direct din browser
RedirectMatch 404 /data(/|$)
<FilesMatch "\.(db|db-wal|db-shm|lock|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Convertorul HEIC (WebAssembly) trebuie servit cu tipul corect
AddType application/wasm .wasm

# Compresie: aplicația și datele ajung de ~4 ori mai mici pe telefon
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml application/wasm
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml application/wasm
</IfModule>

<IfModule mod_headers.c>
  # interfața: verificată la fiecare pornire (oricum pornește instant din memoria telefonului)
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|app\.js|styles\.css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # iconițe și convertorul HEIC: se schimbă rar
  <FilesMatch "\.(png|svg|ico|wasm)$|libheif\.js$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
