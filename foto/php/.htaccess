# Foto Șantier
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(api|files)(/.*)?$ api.php [QSA,L]
</IfModule>

# Datele (baza de date și pozele) nu sunt accesibile direct din browser
RedirectMatch 404 /data(/|$)
<FilesMatch "\.(db|db-wal|db-shm|lock|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
