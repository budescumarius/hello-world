{
  "name": "Foto Șantier",
  "short_name": "Foto Șantier",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f4f5",
  "theme_color": "#1f4fd8",
  "lang": "ro",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".heic",
            ".heif",
            ".png"
          ]
        }
      ]
    }
  }
}