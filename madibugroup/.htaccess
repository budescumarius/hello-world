# Madibu Group — routage vers index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Adresse canonique : https://www.madibugroup.be
  RewriteCond %{HTTP_HOST} ^madibugroup\.be$ [NC]
  RewriteRule ^ https://www.madibugroup.be%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^www\.madibugroup\.be$ [NC]
  RewriteRule ^ https://www.madibugroup.be%{REQUEST_URI} [L,R=301]

  # Ne jamais servir les données ni le code interne
  RewriteRule ^(data|app)(/|$) - [F,L]

  # Anciennes pages WordPress d'administration
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) - [G,L]

  # Fichiers et dossiers réels (assets, uploads, wp-content, admin)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|svg|webp|jpe?g|png|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml application/rss+xml
</IfModule>
