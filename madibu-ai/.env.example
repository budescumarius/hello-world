# MADIBU AI – variables d'environnement (copier en .env.local ; ne jamais committer de vraies valeurs)

# Supabase (local : valeurs affichées par `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service role » : SERVEUR UNIQUEMENT (analyse planifiée, création de comptes). Jamais côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# Connexion directe PostgreSQL (tests de sécurité RLS uniquement)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Secret de l'analyse planifiée (GET /api/cron/daily, en-tête Authorization: Bearer …), 16 caractères min.
CRON_SECRET=

# Claude (facultatif : sans clé, tout fonctionne sauf l'assistant et la synthèse IA du rapport)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MADIBU_AI_RATE_LIMIT=20

# Paramètres métier
MADIBU_COMPANY_NAME=MADIBU GROUP
MADIBU_CASH_ALERT_EUR=20000
MADIBU_MIN_MARGIN_PCT=10
# Webhook de notification des alertes critiques (ex. flux Power Automate « Lors de la réception d'une requête HTTP »)
MADIBU_NOTIFY_WEBHOOK_URL=

# Données de démonstration et tests E2E (local uniquement)
DEMO_PASSWORD=
PW_CHROMIUM_PATH=
